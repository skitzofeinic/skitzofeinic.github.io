---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const fullTitle = `${title} | nguyen anh le`;
const year = new Date().getFullYear();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const person = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Nguyen Anh Le",
    url: Astro.site?.toString(),
    jobTitle: "Software engineering student",
    alumniOf: "Amsterdam University of Applied Sciences",
    sameAs: [
        "https://github.com/skitzofeinic",
        "https://www.linkedin.com/in/anh-le-95b840348/",
    ],
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <link rel="icon" href="/favicon-dark.ico" />
        <meta name="theme-color" content="#0000aa" />

        <!-- fonts: connect early, and fetch only the weights the site uses -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Doto:wght@300&family=Roboto+Mono:wght@300;400&display=swap"
        />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Nguyen Anh Le" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="twitter:card" content="summary" />

        <!-- tells search engines this is the site of a person, and where else they are -->
        <script type="application/ld+json" set:html={JSON.stringify(person)} />

        <script is:inline>
            /* hides the text until the first pixel reveal is ready */
            if (window.matchMedia("(min-width: 768px) and (min-height: 501px)").matches) {
                document.documentElement.classList.add("pixel-pending");
            }
        </script>
    </head>

    <body class="font-mono">
        <!-- for keyboard users: invisible until focused with tab -->
        <a href="#about" class="skip-link">skip to content</a>
        <canvas id="backdrop" aria-hidden="true"></canvas>

        <script>
            /* loaded on its own, after the page, so the backdrop never delays the content */
            import("../scripts/backdrop.ts");
        </script>

        <div class="flex flex-col min-h-screen">
            <header
                class="fixed compact:static top-0 left-0 right-0 min-h-32 phone:min-h-0 p-6 phone:p-4 phone:pl-9 md:p-8 z-20"
            >
                <div class="flex justify-between items-center gap-8 font-doto">
                    <!-- your name leads; the dotted font has no Vietnamese accents, so it goes without -->
                    <h1 class="text-4xl md:text-5xl font-light tracking-wide">
                        NGUYEN ANH LE
                    </h1>

                    <div class="flex items-center gap-4">
                        <p
                            id="morse"
                            aria-hidden="true"
                            class="hidden lg:block text-4xl md:text-5xl font-light tracking-wide font-doto"
                        >
                            - -.-- .--. . / -.-. .- - - ---
                        </p>

                        <!-- phones: one tappable streak per section instead of a menu -->
                        <nav id="nav-streaks" aria-label="Sections" class="md:hidden flex items-center">
                            <a href="#about" class="streak" aria-label="about me"></a>
                            <a href="#professional" class="streak" aria-label="professional"></a>
                            <a href="#education" class="streak" aria-label="education"></a>
                            <a href="#personal" class="streak" aria-label="personal"></a>
                            <a href="#school" class="streak" aria-label="school"></a>
                            <a href="#contact" class="streak" aria-label="contact"></a>
                        </nav>
                    </div>
                </div>

                <p class="text-xs md:text-sm font-mono">
                    PORTFOLIO
                </p>
            </header>

            <div class="flex flex-1 pt-32 pb-20 compact:pt-0 compact:pb-6 phone:pb-[4.75rem]">
                <nav
                    id="nav-main"
                    aria-label="Main"
                    class="hidden md:flex md:flex-col w-48 p-6 md:p-8 fixed compact:absolute left-0 top-32 bottom-20 compact:bottom-auto"
                >
                    <div class="flex flex-col gap-4">
                        <ul class="nav-wheel text-sm">
                            <li><a href="#about" class="nav-link">about</a></li>
                            <li><a href="#professional" class="nav-link">experience</a></li>
                            <li><a href="#education" class="nav-link">education</a></li>
                            <li><a href="#personal" class="nav-link">projects</a></li>
                            <li><a href="#school" class="nav-link">coursework</a></li>
                            <li><a href="#contact" class="nav-link">contact</a></li>
                        </ul>
                    </div>
                </nav>

                <main
                    class="min-w-0 flex-1 md:ml-48 px-6 max-md:pl-9 max-md:pr-4 md:px-8"
                >
                    <slot />
                </main>

            </div>

            <footer
                class="fixed compact:static bottom-0 left-0 right-0 h-20 phone:h-[4.75rem] p-6 phone:pl-9 phone:pr-4 phone:py-3 md:p-8 flex flex-row phone:flex-col justify-between phone:justify-center items-center phone:items-start gap-4 phone:gap-1.5 text-sm z-20"
            >
                <!-- a quiet sign-off and the local time, so recruiters know the time zone -->
                <p class="footer-sign">
                    <span class="footer-copy">© {year} nguyen anh le</span>
                    <span class="footer-time">amsterdam <time id="local-time">--:--</time></span>
                </p>

                <!-- same order as the links by the name, in the footer's label style -->
                <ul class="footer-links">
                    <li><a href="/Nguyen_Anh_Le_Resume.pdf" target="_blank" rel="noopener noreferrer">cv ↗</a></li>
                    <li><a href="https://github.com/skitzofeinic" target="_blank" rel="noopener noreferrer">github ↗</a></li>
                    <li><a href="https://www.linkedin.com/in/anh-le-95b840348/" target="_blank" rel="noopener noreferrer">linkedin ↗</a></li>
                    <li><a href="mailto:anhle261137@gmail.com">gmail ↗</a></li>
                </ul>
            </footer>
        </div>

        <script>
            /* snapping, the pixel reveal, the nav and the phone layout: see the file for details */
            import "../scripts/site.ts";
        </script>
    </body>
</html>
