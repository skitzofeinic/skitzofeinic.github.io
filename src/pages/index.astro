---
import Layout from '../layouts/layout.astro';
---

<Layout>
	<div class="space-y-8">
		<!-- About Me Section -->
		<section>
			<div class="mb-4">
				<h2 class="text-2xl">Hi, I'm Nguyen Anh Le!</h2>
			</div>
			<p class="leading-relaxed">
				I'm a 21-year-old software engineering student at
				<a href="https://www.hva.nl" target="_blank" class="underline">Amsterdam University of Applied Sciences (AUAS)</a>,
				recently interned at <a href="https://aholddelhaize.com/" target="_blank" class="underline">Ahold Delhaize</a>.
				I'm passionate about building scalable software solutions. I'm particularly interested in automation,
				AI, data processing, and creating visually compelling applications. When I'm not coding, you'll find me
				exploring new technologies, listening to music, hitting the gym, going for runs, watching films,
				or diving into a good book.
			</p>
			<hr class="my-6" />
		</section>

		<!-- Skills Section -->
		<div class="skills">
			<div class="sub-skills">
				<h3>frontend</h3>
				<ul>
					<li>Javascript</li>
					<li>Typescript</li>
					<li>React</li>
					<li>Vue</li>
				</ul>
			</div>
			<div class="sub-skills">
				<h3>backend</h3>
				<ul>
					<li>Python</li>
					<li>Java</li>
					<li>Kotlin</li>
					<li>Node.js | Express</li>
					<li>SQL | NoSQL</li>
					<li>Streamlit</li>
					<li>Ollama</li>
				</ul>
			</div>
			<div class="sub-skills">
				<h3>DevOps & infra</h3>
				<ul>
					<li>CI/CD</li>
					<li>Git</li>
					<li>Kubernetes</li>
					<li>ArgoCD</li>
				</ul>
			</div>
			<div class="sub-skills">
				<h3>methodologies</h3>
				<ul>
					<li>Scrum</li>
					<li>Agile</li>
				</ul>
				<br />
				<h3>language skills</h3>
				<ul>
					<li>Dutch</li>
					<li>English</li>
				</ul>
			</div>
			<div class="sub-skills">
				<h3>soft skills</h3>
				<ul>
					<li>Quality Driven</li>
					<li>Self-Motivated</li>
					<li>Fostering Safe Environment</li>
					<li>Open-Minded</li>
					<li>Attention to Detail</li>
					<li>Adaptable Communication & Work Style</li>
				</ul>
			</div>
		</div>
	</div>
</Layout>
