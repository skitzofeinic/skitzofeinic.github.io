---
import Layout from '../../layouts/layout.astro';
---

<Layout>
	<div class="space-y-8">
		<!-- Personal Projects -->
		<div>
			<h2 class="text-2xl mb-6">personal projects</h2>

			<section>
				<div class="flex flex-col md:flex-row md:justify-between gap-2">
					<h3 class="text-lg font-semibold">invoice muncher </h3>
					<h3 class="text-lg font-semibold">[2026]</h3>
				</div>
				<p>
					Developed an automated Python-based PDF parser for invoices and financial statements, leveraging Tesseract OCR and
					Ollama AI to extract a wide range of financial and invoice data, including amounts, dates, vendor names, VAT numbers,
					and other relevant details.
				</p>
				<small>python • tesseract • ollama • tkinter</small>
			</section>

			<hr class="my-6" />

			<section>
				<div class="flex flex-col md:flex-row md:justify-between gap-2">
					<h3 class="text-lg font-semibold">sonic topology</h3>
					<h3 class="text-lg font-semibold">[2026]</h3>
				</div>
				<p>Work in progress...</p>
			</section>
		</div>
	</div>
</Layout>
